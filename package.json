{
  "name": "trifold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "cards:build": "node tools/cards/build-cards.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tools/deals/build-solver.mjs && node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "deals:build-solver": "node tools/deals/build-solver.mjs",
    "deals:calibrate": "node tools/deals/calibration.mjs",
    "deals:generate": "node --experimental-strip-types tools/deals/generate.mjs",
    "deals:probe": "node tools/deals/probe.mjs",
    "deals:verify-all": "node --experimental-strip-types tools/deals/verify-all.mjs",
    "deals:report": "node --experimental-strip-types tools/deals/report.mjs",
    "tutorial:select-deal": "node --experimental-strip-types tools/tutorial/select-tutorial-deal.mjs",
    "dev:yandex": "node tools/dev/yandex-dev.mjs",
    "visual-qa:capture": "node --experimental-strip-types tools/visual-qa/capture.mjs",
    "visual-qa:gallery": "node tools/visual-qa/gallery.mjs",
    "visual-qa:dim": "node tools/visual-qa/dim-pass.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
